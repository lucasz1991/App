APP_NAME=RailTime
APP_VERSION=1.0.0
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=railtime
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=reverb
CACHE_DRIVER=file
FILESYSTEM_DISK=local
MARKETING_DISK=private
MARKETING_SEED_ADMIN_EMAIL=
MARKETING_NODE_BINARY=node
MARKETING_CHROME_PATH=
MARKETING_CHROME_NO_SANDBOX=false
MARKETING_RENDER_TIMEOUT=75
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
AUTH_REMEMBER_LIFETIME=576000

# Chat live locations. The default public OSM endpoint is for normal interactive
# maps only; use an own/provider endpoint for higher traffic or stricter privacy.
CHAT_LIVE_LOCATION_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
CHAT_LIVE_LOCATION_TILE_ATTRIBUTION='&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
CHAT_LIVE_LOCATION_TILE_MAX_ZOOM=19

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
SUPER_ADMIN_MAIL=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

WEBPUSH_ENABLED=false
WEBPUSH_TEST_ENABLED=false
WEBPUSH_AUTO_PROVISION=true
WEBPUSH_QUEUE=default
WEBPUSH_DEFAULT_TTL=3600
WEBPUSH_ALLOWED_ENDPOINT_HOSTS="fcm.googleapis.com,*.push.services.mozilla.com,*.push.apple.com,*.notify.windows.com,*.wns.windows.com,*.push.samsung.com"
VAPID_SUBJECT="mailto:admin@example.com"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# LiveKit-Media-Server (Videoanrufe) – siehe LIVEKIT_INTEGRATION_PLAN.md / SERVER_SETUP.md
LIVEKIT_URL=https://livekit.rail-time.de
LIVEKIT_WS_URL=wss://livekit.rail-time.de
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL=3600
CALL_RING_TIMEOUT=180
LIVEKIT_TURN_MODE=embedded
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Verpflichtende Call-Aufzeichnung. Erst nach Datenschutz-/Rechts-,
# Auftragsverarbeitungs- und Staging-Freigabe aktivieren.
CALL_RECORDING_ENABLED=false
CALL_RECORDING_POLICY_VERSION=2026-08-01
CALL_RECORDING_START_DEADLINE=30
CALL_RECORDING_RETENTION_DAYS=90
CALL_RECORDING_QUEUE=calls
CALL_RECORDING_DISK=call_recordings
CALL_RECORDING_S3_KEY=
CALL_RECORDING_S3_SECRET=
CALL_RECORDING_S3_SESSION_TOKEN=
CALL_RECORDING_S3_REGION=eu-central-1
CALL_RECORDING_S3_BUCKET=
CALL_RECORDING_S3_ENDPOINT=
CALL_RECORDING_S3_PATH_STYLE=false

# RailTime Assist / OpenRouter
# API-Key und Modell werden verschluesselt unter Administration > Einstellungen gepflegt.
RAILTIME_ASSISTANT_NAME="RailTime Assist"
RAILTIME_ASSISTANT_MAX_COMPLETION_TOKENS=4000
RAILTIME_ASSISTANT_USER_PER_MINUTE=6
RAILTIME_ASSISTANT_USER_PER_HOUR=30
RAILTIME_ASSISTANT_USER_PER_DAY=80
RAILTIME_ASSISTANT_GLOBAL_PER_MINUTE=12
RAILTIME_ASSISTANT_GLOBAL_PER_HOUR=100
RAILTIME_ASSISTANT_GLOBAL_PER_DAY=300
RAILTIME_ASSISTANT_PROVIDER_CONCURRENCY=3
OPENROUTER_ALLOWED_HOSTS=openrouter.ai

# Gemeinsamer lokaler TTS/STT-Dienst fuer RailTime und Followflow
SPEECH_SERVICE_ENABLED=false
SPEECH_SERVICE_URL=http://127.0.0.1:8092
SPEECH_SERVICE_CLIENT_ID=railtime
SPEECH_SERVICE_TOKEN=
SPEECH_SERVICE_TOKEN_FILE=
SPEECH_SERVICE_ALLOW_REMOTE=false
SPEECH_SERVICE_CONNECT_TIMEOUT=2
SPEECH_SERVICE_STATUS_TIMEOUT=5
SPEECH_SERVICE_STT_TIMEOUT=300
SPEECH_SERVICE_TTS_TIMEOUT=150
SPEECH_SERVICE_LANGUAGE=de

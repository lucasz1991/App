# REVIEW TEMPLATE ONLY. No [Install] section and no service is enabled here.
# Replace both placeholders after exact OS/path review; keep config root-owned.
[Unit]
Description=RailTime E3 %i (explicitly approved IT pilot only)
After=network.target
ConditionPathExists=/etc/railtime-e3/activation.json

[Service]
Type=simple
User=@TRANSIT_USER@
Group=@TRANSIT_GROUP@
UMask=0077
ExecStart=@PYTHON@ -B @APP_ROOT@/scripts/mail/e3/railtime_e3_cli.py %i
Restart=on-failure
RestartSec=5
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/railtime-e3 /var/spool/postfix/railtime-e3
MemoryMax=256M
TasksMax=32
LimitNOFILE=128
# Admission's exact root-owned sudoers command switches only to the App OS
# user. NoNewPrivileges must NOT be true for that one service; no root shell,
# wildcard, SETENV, DB credential disclosure or arbitrary argv is authorized.
# Return-milter and policy do not invoke the resolver; tighten them separately.
# Root prepares /var/spool/postfix/railtime-e3 as TRANSIT_USER:postfix 2750.
# SGID inheritance supplies socket group postfix; no broad postfix group grant
# to the transit account is required. The daemon verifies owner/group/SGID.

{
  "server": {
    "host": "127.0.0.1",
    "port": 9442,
    "allow_non_loopback": false,
    "request_body_bytes": 32768,
    "response_body_bytes": 65536,
    "request_timeout_ms": 45000
  },
  "auth": {
    "bearer_token_file": "/run/railtime-meshcentral-secrets/railtime-bearer-token",
    "railtime_hmac_secret_file": "/run/railtime-meshcentral-secrets/railtime-hmac-secret"
  },
  "meshcentral": {
    "meshctrl_path": "/opt/railtime-meshcentral-connector/node_modules/meshcentral/meshctrl.js",
    "url": "wss://127.0.0.1:8443",
    "login_user": "railtime-connector",
    "login_domain": "",
    "login_key_file": "/run/railtime-meshcentral-secrets/meshcentral-login-key",
    "platforms": ["windows", "macos", "linux"],
    "remote_support": true,
    "unattended_remote_support": true
  },
  "commands": {
    "execute_script": true,
    "collect_diagnostics": true
  },
  "artifacts": {
    "allowed_hosts": ["app.example.com"],
    "allow_private_hosts": false,
    "max_bytes": 104857600,
    "download_timeout_ms": 20000,
    "windows_target": "C:\\ProgramData\\RailTime\\Staging",
    "posix_target": "/var/tmp/railtime"
  },
  "runtime": {
    "meshctrl_timeout_ms": 30000,
    "meshctrl_output_bytes": 65536
  },
  "state": {
    "directory": "/var/lib/railtime-meshcentral-connector/state",
    "temp_directory": "/var/lib/railtime-meshcentral-connector/tmp"
  },
  "security": {
    "require_strict_file_permissions": true
  }
}

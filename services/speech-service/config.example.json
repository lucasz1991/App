{
  "server": {
    "port": 8092
  },
  "clients": {
    "railtime": {
      "token_sha256": "REPLACE_WITH_RAILTIME_TOKEN_SHA256"
    },
    "followflow": {
      "token_sha256": "REPLACE_WITH_FOLLOWFLOW_TOKEN_SHA256"
    }
  },
  "engines": {
    "ffmpeg": {
      "command": [
        "/usr/bin/ffmpeg"
      ],
      "timeout_seconds": 60
    },
    "whisper": {
      "command": [
        "/var/lib/lmz-speech/runtime/whisper.cpp-1.9.1/build/bin/whisper-cli"
      ],
      "model": "/var/lib/lmz-speech/runtime/models/whisper/ggml-small.bin",
      "language": "de",
      "threads": 0,
      "timeout_seconds": 240
    },
    "piper": {
      "command": [
        "/var/lib/lmz-speech/runtime/piper-1.4.2/bin/piper"
      ],
      "model": "/var/lib/lmz-speech/runtime/models/piper/de_DE-thorsten-medium/de_DE-thorsten-medium.onnx",
      "config": "/var/lib/lmz-speech/runtime/models/piper/de_DE-thorsten-medium/de_DE-thorsten-medium.onnx.json",
      "mode": "cli",
      "timeout_seconds": 120
    }
  },
  "limits": {
    "max_body_bytes": 12000000,
    "max_audio_bytes": 8388608,
    "max_audio_seconds": 60,
    "max_text_chars": 4000,
    "max_transcript_chars": 8000,
    "max_output_audio_bytes": 33554432,
    "request_read_timeout_seconds": 15
  },
  "concurrency": {
    "whisper": 1,
    "piper": 1,
    "http_threads": 8,
    "queue_wait_seconds": 3
  },
  "runtime": {
    "temp_dir": "/var/lib/lmz-speech/tmp"
  }
}
